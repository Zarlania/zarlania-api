# Local development overrides, read by docker compose (and documented for
# ./mvnw spring-boot:run, whose defaults match). Copy to .env and edit;
# .env is gitignored. Nothing in this file is a production secret.
#
# .env is read by docker compose only, not by Maven: editing a value here
# changes what `docker compose up` uses, but `./mvnw spring-boot:run` always
# falls back to application.yml's own ${DB_HOST:localhost}-style defaults
# regardless of what is in this file.

# Host port the API publishes on.
API_PORT=8080

# Database host for ./mvnw spring-boot:run. Inside the compose network the API
# container talks to Postgres over DB_HOST=postgres, hardcoded in
# docker-compose.yml — not read from .env — so this value only matters when
# running spring-boot:run against the compose Postgres from the host.
DB_HOST=localhost

# Host port Postgres publishes on.
DB_PORT=5432

# Local database name and credentials. Harmless localhost-only defaults.
DB_NAME=zarlania
DB_USER=zarlania
DB_PASSWORD=zarlania

# Auth (local): leave JWT_PRIVATE_KEY unset to use an ephemeral dev keypair,
# regenerated on every restart. Generate a real one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#JWT_PRIVATE_KEY=
# Only needed when rotating keys locally; safe to leave unset otherwise.
#JWT_RETIRED_PUBLIC_KEYS=
# Cookies must not require HTTPS against a local http:// frontend. Uncommented
# because it actively needs to differ from application.yml's own default
# (true, correct for every hosted environment) for local auth flows to work
# at all — see docs/references/000002-authentication-and-tokens.md.
AUTH_COOKIE_SECURE=false
# Leave unset locally: EmailConfig falls back to LoggingEmailSender, which
# logs the message instead of sending it. Only needed to exercise Resend for
# real (e.g. testing the account and DNS setup from the auth reference doc).
#RESEND_API_KEY=
# These three already default sensibly in application.yml for local dev, so
# they are documented here rather than set — uncomment only to override.
#EMAIL_FROM=no-reply@zarlania.com
#JWT_ISSUER=https://api.zarlania.com
#APP_BASE_URL=https://zarlania.com
# Origin(s) the local zarlania-app dev server runs on, comma-separated if
# more than one. Matches application.yml's own default (the Vite dev server
# port), so this only needs uncommenting if your frontend runs elsewhere.
#ZARLANIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
